             }
         }
-        // Final round of move
-        wl_fixed_t lastX;
-        wl_fixed_t lastY;
-        if (m_pointerType == PointerKind::Mouse) {
-            lastX = wl_fixed_from_int(lastPosIt->x() + m_pos.x());
-            lastY = wl_fixed_from_int(lastPosIt->y() + m_pos.y());
