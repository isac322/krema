+// --stdin mode: one request per line, {"id": <int>, "actions": [...]} runs a
+// chain, {"resume": <id>} ends that chain's interruptible pause (the one in
+// progress, or its next one). Each chain runs on its own thread, so a chain
+// sitting in a pause does not hold up the requests after it. A finished chain
+// is answered with {"id": <id>, "ok": true}; an unparsable line with
+// {"id": null, "ok": false, "error": "..."}. EOF on stdin ends the process
+// once the chains in flight have finished. Everything but the chains' own
+// actions runs on the GUI thread.
+struct Chain {
+    qint64 id = 0;
+    std::atomic_bool resume = false;
+    std::vector<BaseAction *> actions;
+};
