+_ATSPI_ACCESSIBLE = 'org.a11y.atspi.Accessible'
+_ATSPI_NULL_PATH = '/org/a11y/atspi/null'
+_DBUS_PROPERTIES = 'org.freedesktop.DBus.Properties'
+# One node's calls (key, XML attribute, interface, method, parameters, reply type): what _createNode2 reads through
+# libatspi, with GetChildren in place of ChildCount + GetChildAtIndex (Qt answers both from the same
+# childCount()/child(i)). The role (the tag name) and the children are always read; the calls for the other
+# attributes only when the tree is built for an XPath that can read them.
+_NODE_CALLS = (
+    ('role', None, _ATSPI_ACCESSIBLE, 'GetRole', None, GLib.VariantType('(u)')),
+    ('name', 'name', _DBUS_PROPERTIES, 'Get', GLib.Variant('(ss)', (_ATSPI_ACCESSIBLE, 'Name')), GLib.VariantType('(v)')),
+    ('description', 'description', _DBUS_PROPERTIES, 'Get', GLib.Variant('(ss)', (_ATSPI_ACCESSIBLE, 'Description')), GLib.VariantType('(v)')),
+    ('id', 'accessibility-id', _DBUS_PROPERTIES, 'Get', GLib.Variant('(ss)', (_ATSPI_ACCESSIBLE, 'AccessibleId')), GLib.VariantType('(v)')),
+    ('states', 'states', _ATSPI_ACCESSIBLE, 'GetState', None, GLib.VariantType('(au)')),
+    ('children', None, _ATSPI_ACCESSIBLE, 'GetChildren', None, GLib.VariantType('(a(so))')),
+)
+_OPTIONAL_ATTRIBUTES = frozenset(call[1] for call in _NODE_CALLS if call[1])
+# An attribute reference in an XPath: @name, attribute::name, or anything else after @ / attribute:: (@*, @node()).
+_XPATH_ATTRIBUTE = re.compile(r'(?:@|attribute\s*::)\s*([\w.-]*)(\s*\()?')
+_a11y_bus = None
+_a11y_bus_lock = threading.Lock()
+
+
+def _a11y_connection():
+    # Own connection to the accessibility bus (the one libatspi uses), for asynchronous calls.
+    global _a11y_bus
+    with _a11y_bus_lock:
+        if _a11y_bus is None or _a11y_bus.is_closed():
+            address = os.environ.get('AT_SPI_BUS_ADDRESS')
+            if not address:
+                session_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
+                address = session_bus.call_sync('org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Bus', 'GetAddress', None,
+                                                GLib.VariantType('(s)'), Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
+            _a11y_bus = Gio.DBusConnection.new_for_address_sync(
+                address,
+                Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
+                None, None)
+        return _a11y_bus
+
+
+class _PipelineUnsupported(Exception):
+    pass
+
+
+def _createTree(accessible, attributes=None):
+    # Same XML as _createNode2(accessible, None), but the D-Bus calls for every node are sent asynchronously and are
+    # all in flight at once, instead of ~8 synchronous round trips per node one after the other. (Qt's
+    # org.a11y.atspi.Cache.GetItems returns no items, so no single call returns the whole tree.) Whatever this cannot
+    # reproduce exactly (another toolkit, the desktop root, a node that vanished or answers with an error, a role
+    # outside libatspi's table) is built the synchronous way.
+    # attributes: the optional XML attributes (_OPTIONAL_ATTRIBUTES) to read, None for all of them; the synchronous
+    # build always has all. Returns the tree and, for the pipelined build, each element's D-Bus object path by its
+    # path attribute (None for the synchronous build).
+    try:
+        return _createTreePipelined(accessible, attributes)
+    except _PipelineUnsupported:
+        return _createNode2(accessible, None), None
+
+
+def _xpathAttributes(selector):
+    # The optional attributes an XPath can read: the ones it names after @ or attribute::. Any other attribute
+    # reference (@*, @node(), an @ inside a string literal, ...) may read any of them: None (all).
+    attributes = set()
+    for match in _XPATH_ATTRIBUTE.finditer(selector):
+        name = match.group(1)
+        if match.group(2) or (name not in _OPTIONAL_ATTRIBUTES and name not in ('role', 'path')):
+            return None
+        attributes.add(name)
+    return attributes
+
+
+def _stringValue(reply):
+    # The string in a Properties.Get reply (child 0 of the result tuple), or _PipelineUnsupported.
+    value = reply.get_variant()
+    if value.get_type_string() != 's':
+        raise _PipelineUnsupported()
+    return value.get_string()
+
+
+def _createTreePipelined(accessible, attributes):
+    if not accessible or accessible.toolkitName != "Qt":
+        raise _PipelineUnsupported()
+    bus_name = accessible.app.bus_name
+    connection = _a11y_connection()
+    context = GLib.MainContext.new()
+    calls = tuple(call for call in _NODE_CALLS if call[1] is None or attributes is None or call[1] in attributes)
+    nodes = {}  # object path -> {key: reply value}
+    pending = 0
+    failed = False
+
+    def reply(conn, result, path, key):
+        nonlocal pending, failed
+        pending -= 1
+        try:
+            value = conn.call_finish(result).get_child_value(0)
+            if key in ('name', 'description', 'id'):
+                value = _stringValue(value)
+            elif key == 'role':
+                value = value.get_uint32()
+            else:
+                value = value.unpack()
+        except GLib.Error:
+            if key != 'id':
+                failed = True
+                return
+            value = None  # libatspi's accessibleId when the toolkit has none (Qt < 6.6)
+        except Exception:  # an exception in a GLib callback would only be printed
+            failed = True
+            return
+        nodes[path][key] = value
+        if key == 'children':
+            for child_bus, child_path in value:
+                if child_path == _ATSPI_NULL_PATH:
+                    continue  # _createNode2 skips a null child
+                if child_bus != bus_name or child_path in nodes:
+                    failed = True  # another application's object; an object under two parents
+                    return
+                request(child_path)
+
+    def request(path):
+        nonlocal pending
+        nodes[path] = {}
+        for key, _attribute, interface, method, parameters, reply_type in calls:
+            connection.call(bus_name, path, interface, method, parameters, reply_type, Gio.DBusCallFlags.NONE, 4000,
+                            None, reply, path, key)
+            pending += 1  # the reply is dispatched by context.iteration() below, never before this
+
+    context.push_thread_default()
+    try:
+        request(accessible.path)
+        while pending > 0:
+            context.iteration(True)
+    finally:
+        context.pop_thread_default()
+    if failed:
+        raise _PipelineUnsupported()
+
+    objectPaths = {}
+
+    def element(path, indexInParents):
+        node = nodes[path]
+        role = node['role']
+        if role >= Atspi.ROLE_COUNT or role == Atspi.Role.EXTENDED or len(node.get('states', (0, 0))) != 2:
+            raise _PipelineUnsupported()  # libatspi would ask the toolkit for the role name / reject the state set
+        roleName = _role_name(role)
+        e = etree.Element(roleName.replace(" ", "_") if roleName else "accessible")
+        if 'name' in node:
+            e.set("name", node['name'])
+        e.set("role", str(role))
+        if 'description' in node:
+            e.set("description", node['description'])
+        if node.get('id') != None:
+            e.set("accessibility-id", node['id'])
+        pathString = ' '.join(str(x) for x in indexInParents)
+        e.set("path", pathString)
+        objectPaths[pathString] = path
+        if 'states' in node:
+            # pyatspi's StateSet.getStates() lists the 64 state bits (GetState: low word, high word) in bit order.
+            bits = node['states'][0] | (node['states'][1] << 32)
+            e.set("states", ', '.join(_state_name(i) for i in range(64) if bits & (1 << i)))
+        for i, (_child_bus, child_path) in enumerate(node['children']):
+            if child_path != _ATSPI_NULL_PATH:
+                e.append(element(child_path, indexInParents + [i]))
+        return e
+
+    return element(accessible.path, []), objectPaths
+
+
+def _liveObject(root, indexPath, objectPaths):
+    # The accessible a pipelined tree element stands for, reached from root through libatspi, or None when it has
+    # left the tree. Each step checks the child's D-Bus object path, so the walk cannot end on another object after
+    # the tree changed; where a sibling was added or removed before it (its index shifted), the child is looked up
+    # among the parent's current children by object path. (Upstream compares the element's name and description
+    # with the object's instead, which also fails for the same object when one of them changed after the build,
+    # e.g. a dock item's description gaining "Active" as its window is activated.)
+    item = root
+    for depth, index in enumerate(indexPath):
+        wanted = objectPaths[' '.join(str(x) for x in indexPath[:depth + 1])]
+        count = item.childCount
+        child = item.getChildAtIndex(index) if index < count else None
+        if child is None or child.path != wanted:
+            child = next((c for c in (item.getChildAtIndex(i) for i in range(count)) if c is not None and c.path == wanted),
+                         None)
+            if child is None:
+                return None
+        item = child
+    return item
+
+
+@functools.cache
+def _role_name(role):
+    return Atspi.role_get_name(Atspi.Role(role))
+
+
+@functools.cache
+def _state_name(state):
+    return pyatspi.stateToString(Atspi.StateType(state))
+
